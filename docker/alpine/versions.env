# Alpine + OpenResty build pins.
# Edit OPENRESTY_VERSION here to target a newer OpenResty release, then rebuild.
#
# Or override without editing:
#   OPENRESTY_VERSION=1.27.1.2 ./scripts/buildx-alpine-openresty --load -t local/nginx-proxy-manager:alpine-openresty
#   docker build --build-arg OPENRESTY_VERSION=1.27.1.2 -f docker/Dockerfile.alpine-openresty ...
#
# OPENRESTY_VERSION must match a GitHub tag on openresty/openresty (vX.Y.Z.W).
# GEOIP2_REF is a commit SHA (or tag) on leev/ngx_http_geoip2_module.

OPENRESTY_VERSION=1.29.2.5
ALPINE_VERSION=3.24
GEOIP2_REF=445df24ef3781e488cee3dfe8a1e111997fc1dfe
USE_LTO=0
JOBS=2
